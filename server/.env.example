# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/api-security-dashboard
# Or MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/api-security-dashboard

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Redis (for BullMQ scan queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Recommendations (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
